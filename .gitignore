# Environnements virtuels Python
.venv/
venv/
env/
ENV/

# Secrets et configuration locale
.env
.env.*
!.env.example
!.env.template

# Cache et fichiers temporaires Python
__pycache__/
*.py[cod]
*$py.class
.Python

# Tests, couverture et vérifications statiques
.pytest_cache/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Paquets et artefacts de compilation Python
build/
dist/
pip-wheel-metadata/
*.egg-info/
*.whl

# Documentation générée localement (Sphinx)
/docs/_build/
/docs/build/

# Fichiers locaux d'IDE
.vscode/
.idea/

# Fichiers système
.DS_Store
Thumbs.db
Desktop.ini

# Installateurs binaires volumineux utilisés comme fixtures locales
/tests/fixtures/executables/*.exe
